# ============================================================
# Chatooz Server — Environment Variables
# ============================================================
# Copy this to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# ── Required in Production ──────────────────────────────────

# Long random secret for session token signing
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# HTTP server port (Railway sets this automatically via $PORT)
PORT=8080

# WebSocket media relay port
WS_PORT=8081

# Path to SQLite database file
# On Railway with a volume: /data/chatooz.db
# Local development: ./chatooz.db
DB_PATH=./chatooz.db

# ── Optional ────────────────────────────────────────────────

# CORS allowed origins (restrict in production to your app domain)
# Example: https://chatooz.app
ALLOW_ORIGINS=*

# Max message age in seconds before cleanup (default: 30 days)
MAX_MSG_AGE=2592000
